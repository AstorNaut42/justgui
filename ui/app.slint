import { Button, LineEdit, ScrollView, TabWidget, TextEdit, CheckBox, Palette } from "std-widgets.slint";

// Populated from `justgui.toml` at startup and re-applied live on change --
// every color/spacing value in this file should flow through here rather
// than being hardcoded, so the config file can actually restyle the app.
export global Theme {
    in property <color> background: #1e1e1e;
    in property <color> panel-background: #2a2a2a;
    in property <color> border: #3c3c3c;
    in property <color> accent: #7ec8ff;
    in property <color> text: #e6e6e6;
    in property <color> muted-text: #999999;
    in property <color> error: #ff6666;
    in property <color> warning: #ffaa33;
    in property <length> corner-radius: 6px;
    in property <string> font-family;
    in property <length> font-size: 14px;
    in property <bool> dark-mode: true;
}

export struct ParamData {
    name: string,
    hint: string,
    default-value: string,
}

export struct RecipeData {
    name: string,
    doc: string,
    is-private: bool,
    params: [ParamData],
}

export component AppWindow inherits Window {
    title: "justgui";
    preferred-width: 1000px;
    preferred-height: 700px;
    background: Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;

    // Mirrors Theme.dark-mode so `changed` has a local property to watch;
    // also applied once via `init` for the very first frame.
    property <bool> dark-mode-mirror: Theme.dark-mode;
    init => { Palette.color-scheme = self.dark-mode-mirror ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode-mirror => { Palette.color-scheme = self.dark-mode-mirror ? ColorScheme.dark : ColorScheme.light; }

    in-out property <string> directory;
    in-out property <bool> show-private: false;
    in-out property <string> edit-buffer;

    in property <[RecipeData]> recipes;
    in property <string> load-error;
    in property <string> run-log;
    in property <bool> running;
    in property <bool> edit-dirty;
    in property <string> edit-status;
    in property <string> justfile-path;

    callback reload();
    callback run-recipe(int);
    callback param-edited(int, int, string);
    callback save-edit();
    callback edit-touched();
    callback clear-log();

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            Text { text: "Directory:"; vertical-alignment: center; }
            LineEdit {
                text <=> root.directory;
                horizontal-stretch: 1;
            }
            Button { text: "Reload"; clicked => { root.reload(); } }
        }

        Rectangle { height: 1px; background: Theme.border; }

        TabWidget {
            Tab {
                title: "Recipes";
                VerticalLayout {
                    spacing: 6px;

                    if root.load-error != "" : Text {
                        text: root.load-error;
                        color: Theme.error;
                        wrap: word-wrap;
                    }

                    if root.load-error == "" : CheckBox {
                        text: "Show private recipes";
                        checked <=> root.show-private;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for recipe[ri] in root.recipes : Rectangle {
                                visible: !recipe.is-private || root.show-private;
                                background: Theme.panel-background;
                                border-radius: Theme.corner-radius;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: recipe.name; font-weight: 700; color: Theme.accent; }
                                        Text { text: recipe.doc; color: Theme.muted-text; }
                                    }

                                    for param[pi] in recipe.params : HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: param.name; vertical-alignment: center; min-width: 110px; }
                                        LineEdit {
                                            text: param.default-value;
                                            placeholder-text: param.hint;
                                            horizontal-stretch: 1;
                                            edited(t) => { root.param-edited(ri, pi, t); }
                                        }
                                    }

                                    Button {
                                        text: "Run";
                                        enabled: !root.running;
                                        clicked => { root.run-recipe(ri); }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.running ? "Output (running...)" : "Output"; vertical-alignment: center; }
                        Button { text: "Clear"; clicked => { root.clear-log(); } }
                    }

                    Rectangle {
                        background: Theme.panel-background;
                        border-radius: Theme.corner-radius;
                        vertical-stretch: 1;
                        ScrollView {
                            Text {
                                text: root.run-log;
                                wrap: word-wrap;
                                font-family: "monospace";
                                font-size: 13px;
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Edit justfile";
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.justfile-path == "" ? "(no justfile found)" : root.justfile-path;
                            color: Theme.muted-text;
                        }
                        if root.edit-dirty : Text { text: "(unsaved changes)"; color: Theme.warning; }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Save"; enabled: root.justfile-path != ""; clicked => { root.save-edit(); } }
                        Button { text: "Reload from disk"; clicked => { root.reload(); } }
                        Text { text: root.edit-status; color: Theme.muted-text; vertical-alignment: center; }
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    TextEdit {
                        text <=> root.edit-buffer;
                        vertical-stretch: 1;
                        font-family: "monospace";
                        edited(t) => { root.edit-touched(); }
                    }
                }
            }
        }
    }
}
