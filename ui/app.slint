import { Button, LineEdit, ScrollView, TabWidget, TextEdit, CheckBox, Palette, Slider, Switch, SpinBox } from "std-widgets.slint";

// Populated from `justgui.toml` at startup and re-applied live on change --
// every color/spacing value in this file should flow through here rather
// than being hardcoded, so the config file can actually restyle the app.
export global Theme {
    in property <color> background: #1e1e1e;
    in property <color> panel-background: #2a2a2a;
    in property <color> border: #3c3c3c;
    in property <color> accent: #7ec8ff;
    in property <color> text: #e6e6e6;
    in property <color> muted-text: #999999;
    in property <color> error: #ff6666;
    in property <color> warning: #ffaa33;
    in property <length> corner-radius: 6px;
    in property <string> font-family;
    in property <length> font-size: 14px;
    in property <bool> dark-mode: true;
}

export struct ParamData {
    name: string,
    hint: string,
    default-value: string,
}

export struct RecipeData {
    recipe-index: int, // stable index into the unfiltered recipe list
    name: string,
    doc: string,
    is-private: bool,
    is-shown: bool,
    color: color,
    params: [ParamData],
}

export component AppWindow inherits Window {
    title: "justgui";
    preferred-width: 1000px;
    preferred-height: 700px;
    background: Theme.background.with-alpha(root.transparency);
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;

    // Mirrors Theme.dark-mode so `changed` has a local property to watch;
    // also applied once via `init` for the very first frame.
    property <bool> dark-mode-mirror: Theme.dark-mode;
    init => { Palette.color-scheme = self.dark-mode-mirror ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode-mirror => { Palette.color-scheme = self.dark-mode-mirror ? ColorScheme.dark : ColorScheme.light; }

    in-out property <string> directory;
    in-out property <bool> show-private: false;
    in-out property <string> edit-buffer;
    in-out property <string> stdin-text;
    in-out property <float> transparency: 1.0;
    in-out property <bool> output-collapsed: false;
    in-out property <length> output-height: 220px;

    in property <[RecipeData]> recipes;     // filtered + ordered, for the grid
    in property <[RecipeData]> all-recipes; // everyone + ordered, for the picker
    in property <string> load-error;
    in property <string> run-log;
    in property <bool> running;
    in property <bool> edit-dirty;
    in property <string> edit-status;
    in property <string> justfile-path;
    in property <[color]> palette;
    in property <string> theme-status;
    in property <int> theme-corner-radius;
    in property <int> theme-font-size;
    in property <string> theme-font-family;
    in property <bool> theme-dark-mode;

    // Which recipe (by recipe-index) is currently "picked up" to be moved;
    // -1 means nothing is picked up. Purely local UI state, not persisted --
    // click a tile's move handle to pick it up, click another tile to swap.
    property <int> reordering-recipe-index: -1;

    callback reload();
    callback run-recipe(int);
    callback param-edited(int, int, string);
    callback save-edit();
    callback edit-touched();
    callback clear-log();
    callback send-input(string);
    callback close-input();
    callback show-private-toggled(bool);
    callback toggle-shown(int, bool);
    callback recipe-dropped(int, int);
    callback set-recipe-color(int, color);
    callback set-theme-color(string, color);
    callback set-theme-field(string, string);
    callback save-theme();

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        dir-row := HorizontalLayout {
            spacing: 6px;
            Text { text: "Directory:"; vertical-alignment: center; }
            LineEdit {
                text <=> root.directory;
                horizontal-stretch: 1;
            }
            Button { text: "Reload"; clicked => { root.reload(); } }
        }

        toolbar-row := HorizontalLayout {
            spacing: 6px;
            Text { text: "Transparency:"; vertical-alignment: center; }
            Slider {
                minimum: 0.2;
                maximum: 1;
                value <=> root.transparency;
                horizontal-stretch: 1;
            }
            Button { text: "Theme"; clicked => { theme-popup.show(); } }
        }

        theme-popup := PopupWindow {
            x: 0px;
            y: dir-row.height + toolbar-row.height + 12px;
            width: 320px;
            height: 340px;
            close-policy: PopupClosePolicy.close-on-click-outside;
            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.panel-background;
                border-radius: Theme.corner-radius;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    Text { text: "Theme"; font-weight: 700; color: Theme.accent; }

                    for field-name[fi] in [
                        "background", "panel-background", "border", "accent",
                        "text", "muted-text", "error", "warning",
                    ] : HorizontalLayout {
                        spacing: 6px;
                        Text { text: field-name; vertical-alignment: center; min-width: 110px; }
                        for c[ci] in root.palette : Rectangle {
                            width: 14px;
                            height: 14px;
                            border-radius: 3px;
                            background: c;
                            TouchArea { clicked => { root.set-theme-color(field-name, c); } }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "dark mode"; vertical-alignment: center; min-width: 110px; }
                        Switch {
                            checked: root.theme-dark-mode;
                            toggled => { root.set-theme-field("mode", self.checked ? "dark" : "light"); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "corner radius"; vertical-alignment: center; min-width: 110px; }
                        SpinBox {
                            minimum: 0;
                            maximum: 40;
                            value: root.theme-corner-radius;
                            edited => { root.set-theme-field("corner-radius", "\{self.value}"); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "font size"; vertical-alignment: center; min-width: 110px; }
                        SpinBox {
                            minimum: 8;
                            maximum: 32;
                            value: root.theme-font-size;
                            edited => { root.set-theme-field("font-size", "\{self.value}"); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "font family"; vertical-alignment: center; min-width: 110px; }
                        LineEdit {
                            text: root.theme-font-family;
                            placeholder-text: "system default";
                            horizontal-stretch: 1;
                            edited(t) => { root.set-theme-field("font-family", t); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Save"; clicked => { root.save-theme(); } }
                        Text { text: root.theme-status; color: Theme.muted-text; vertical-alignment: center; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        TabWidget {
            vertical-stretch: 1;

            Tab {
                title: "Recipes";
                VerticalLayout {
                    spacing: 6px;

                    if root.load-error != "" : Text {
                        text: root.load-error;
                        color: Theme.error;
                        wrap: word-wrap;
                    }

                    select-row := HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Select recipes"; clicked => { picker.show(); } }
                    }

                    picker := PopupWindow {
                        x: 0px;
                        y: select-row.height + 4px;
                        width: 260px;
                        height: 320px;
                        close-policy: PopupClosePolicy.close-on-click-outside;
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Theme.panel-background;
                            border-radius: Theme.corner-radius;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;

                                CheckBox {
                                    text: "Show hidden recipes";
                                    checked <=> root.show-private;
                                    toggled => { root.show-private-toggled(self.checked); }
                                }

                                Rectangle { height: 1px; background: Theme.border; }

                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        spacing: 2px;
                                        for recipe[_] in root.all-recipes : VerticalLayout {
                                            if !recipe.is-private || root.show-private : CheckBox {
                                                text: recipe.name;
                                                checked: recipe.is-shown;
                                                toggled => { root.toggle-shown(recipe.recipe-index, self.checked); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        viewport-width: grid.width;
                        viewport-height: grid.height;
                        grid := Rectangle {
                            property <length> tile-w: 220px;
                            property <length> tile-h: 110px;
                            property <length> gap: 8px;
                            property <int> cols: max(1, floor((self.width - gap) / (tile-w + gap)));
                            width: parent.width;
                            height: root.recipes.length > 0 ? ceil(root.recipes.length / cols) * (tile-h + gap) + gap : 0px;

                            for recipe[i] in root.recipes : Rectangle {
                                x: mod(i, cols) * (tile-w + gap) + gap;
                                y: floor(i / cols) * (tile-h + gap) + gap;
                                width: tile-w;
                                height: tile-h;
                                background: recipe.color;
                                border-radius: Theme.corner-radius;
                                border-width: root.reordering-recipe-index == recipe.recipe-index ? 3px : 0px;
                                border-color: Theme.text;

                                TouchArea {
                                    clicked => {
                                        if (root.reordering-recipe-index >= 0 && root.reordering-recipe-index != recipe.recipe-index) {
                                            root.recipe-dropped(root.reordering-recipe-index, recipe.recipe-index);
                                            root.reordering-recipe-index = -1;
                                        } else if (recipe.params.length == 0) {
                                            root.run-recipe(recipe.recipe-index);
                                        } else {
                                            param-popup.show();
                                        }
                                    }

                                    VerticalLayout {
                                        padding: 8px;
                                        alignment: center;
                                        Text {
                                            text: recipe.name;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Tooltip { text: @markdown("\{recipe.doc}"); }
                                }

                                // Small corner handle: click to pick this tile
                                // up, then click another tile to swap places.
                                TouchArea {
                                    x: parent.width - 22px;
                                    y: 2px;
                                    width: 20px;
                                    height: 20px;
                                    clicked => {
                                        root.reordering-recipe-index = root.reordering-recipe-index == recipe.recipe-index ? -1 : recipe.recipe-index;
                                    }
                                    Text { text: "⇄"; color: Theme.text; }
                                }

                                // Small corner handle: click to open the color
                                // swatch popover for this recipe.
                                TouchArea {
                                    x: 2px;
                                    y: 2px;
                                    width: 20px;
                                    height: 20px;
                                    clicked => { color-popup.show(); }
                                    Text { text: "🎨"; }
                                }

                                color-popup := PopupWindow {
                                    x: 0px;
                                    y: tile-h + 4px;
                                    width: root.palette.length * 20px + 12px;
                                    height: 28px;
                                    close-policy: PopupClosePolicy.close-on-click-outside;
                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: Theme.panel-background;
                                        border-radius: Theme.corner-radius;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        HorizontalLayout {
                                            padding: 6px;
                                            spacing: 4px;
                                            for c[ci] in root.palette : Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 3px;
                                                background: c;
                                                TouchArea {
                                                    clicked => {
                                                        root.set-recipe-color(recipe.recipe-index, c);
                                                        color-popup.close();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                param-popup := PopupWindow {
                                    x: 0px;
                                    y: tile-h + 4px;
                                    width: 260px;
                                    height: 90px + recipe.params.length * 36px;
                                    close-policy: PopupClosePolicy.close-on-click-outside;
                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: Theme.panel-background;
                                        border-radius: Theme.corner-radius;
                                        border-width: 1px;
                                        border-color: Theme.border;

                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 6px;

                                            Text { text: recipe.name; font-weight: 700; color: Theme.accent; }
                                            if recipe.doc != "" : Text { text: recipe.doc; color: Theme.muted-text; wrap: word-wrap; }

                                            for param[pi] in recipe.params : HorizontalLayout {
                                                spacing: 6px;
                                                Text { text: param.name; vertical-alignment: center; min-width: 80px; }
                                                LineEdit {
                                                    text: param.default-value;
                                                    placeholder-text: param.hint;
                                                    horizontal-stretch: 1;
                                                    edited(t) => { root.param-edited(recipe.recipe-index, pi, t); }
                                                }
                                            }

                                            Button {
                                                text: "Run";
                                                enabled: !root.running;
                                                clicked => {
                                                    root.run-recipe(recipe.recipe-index);
                                                    param-popup.close();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Edit justfile";
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.justfile-path == "" ? "(no justfile found)" : root.justfile-path;
                            color: Theme.muted-text;
                        }
                        if root.edit-dirty : Text { text: "(unsaved changes)"; color: Theme.warning; }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Save"; enabled: root.justfile-path != ""; clicked => { root.save-edit(); } }
                        Button { text: "Reload from disk"; clicked => { root.reload(); } }
                        Text { text: root.edit-status; color: Theme.muted-text; vertical-alignment: center; }
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    TextEdit {
                        text <=> root.edit-buffer;
                        vertical-stretch: 1;
                        font-family: "monospace";
                        edited(t) => { root.edit-touched(); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 6px;
            output-toggle := TouchArea {
                horizontal-stretch: 1;
                clicked => { root.output-collapsed = !root.output-collapsed; }
                HorizontalLayout {
                    Text {
                        text: (root.output-collapsed ? "▸ " : "▾ ") + (root.running ? "Output (running...)" : "Output");
                        vertical-alignment: center;
                    }
                }
            }
            Button { text: "Clear"; clicked => { root.clear-log(); } }
        }

        if !root.output-collapsed : splitter := Rectangle {
            height: 6px;
            background: splitter-area.has-hover || splitter-area.pressed ? Theme.accent : Theme.border;

            splitter-area := TouchArea {
                property <length> drag-start-height;
                mouse-cursor: MouseCursor.row-resize;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.drag-start-height = root.output-height;
                    }
                }
                moved => {
                    root.output-height = max(60px, min(600px, self.drag-start-height + (self.pressed-y - self.mouse-y)));
                }
            }
        }

        if !root.output-collapsed : Rectangle {
            background: Theme.panel-background;
            border-radius: Theme.corner-radius;
            height: root.output-height;
            clip: true;
            TextEdit {
                text: root.run-log;
                read-only: true;
                wrap: word-wrap;
                font-family: "monospace";
                font-size: 13px;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            LineEdit {
                text <=> root.stdin-text;
                placeholder-text: "Input for the running recipe -- Enter to send";
                enabled: root.running;
                horizontal-stretch: 1;
                accepted(t) => { root.send-input(t); root.stdin-text = ""; }
            }
            Button {
                text: "Send";
                enabled: root.running;
                clicked => { root.send-input(root.stdin-text); root.stdin-text = ""; }
            }
            Button {
                text: "Close input";
                enabled: root.running;
                clicked => { root.close-input(); }
            }
        }
    }
}
